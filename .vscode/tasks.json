{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Flash",
            "type": "shell",
            "command": "C:/EmbeddedTools/openocd/bin/openocd.exe",
            "args": [
                "-s",
                "C:/EmbeddedTools/openocd/openocd/scripts",
                "-f",
                "interface/stlink.cfg",
                "-f",
                "target/stm32f1x.cfg",
                "-c",
                "program build/firmware.elf verify reset exit"
            ],
            "dependsOn": "Build",
            "problemMatcher": []
        }
    ]
}